# Copy to .env locally; fill values privately. Never add real credentials here.
FEEDINTEL_MODE=demo
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate your own local token; required even in demo mode.
DEMO_ACCESS_TOKEN=

# Live mode: FEEDINTEL_MODE=live
SUPABASE_URL=
# Server-only secret key (or legacy SUPABASE_SERVICE_ROLE_KEY).
SB_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated UUIDs of manually created, non-anonymous demo accounts.
DEMO_USER_IDS=
# Default intelligence when the request does not explicitly choose one.
INTELLIGENCE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# Choose a model with structured JSON output available to your Anthropic account.
ANTHROPIC_MODEL=
# HTTPS URL of your own Lovable-hosted AI bridge (see docs/lovable-intelligence.md).
LOVABLE_ANALYSIS_URL=
# Shared server-to-server token, configured privately in both backends.
LOVABLE_BRIDGE_TOKEN=
ORIANE_API_KEY=
# Confirm these two settings against your account's authentication example.
ORIANE_AUTH_HEADER=
# For example, a documented bearer scheme would use: Bearer {key}
ORIANE_AUTH_TEMPLATE=
